+    ngx_http_v2_out_frame_t   *frame, *trailers, **fn;
     ngx_http_v2_connection_t  *h2c;
 
     r = fc->data;
@@ -1156,6 +1156,8 @@ ngx_http_v2_send_chain(ngx_connection_t *fc, ngx_chain_t *in, off_t limit)
 
     trailers = NGX_HTTP_V2_NO_TRAILERS;
 
+    fn = ngx_http_v2_queue_position(h2c, stream);
+
 #if (NGX_SUPPRESS_WARN)
     cl = NULL;
 #endif
@@ -1225,6 +1227,7 @@ ngx_http_v2_send_chain(ngx_connection_t *fc, ngx_chain_t *in, off_t limit)
             }
 
             if (trailers != NGX_HTTP_V2_NO_TRAILERS) {
+                trailers->blocked = 0;
                 cl->buf->last_buf = 0;
             }
         }
@@ -1236,9 +1239,10 @@ ngx_http_v2_send_chain(ngx_connection_t *fc, ngx_chain_t *in, off_t limit)
                 return NGX_CHAIN_ERROR;
             }
 
-            ngx_http_v2_queue_frame(h2c, frame);
+            ngx_http_v2_queue_frame(fn, frame);
 
             h2c->send_window -= frame_size;
+            h2c->send_queued += frame_size;
 
             stream->send_window -= frame_size;
             stream->queued++;
@@ -1247,7 +1251,7 @@ ngx_http_v2_send_chain(ngx_connection_t *fc, ngx_chain_t *in, off_t limit)
         if (in == NULL) {
 
             if (trailers != NGX_HTTP_V2_NO_TRAILERS) {
-                ngx_http_v2_queue_frame(h2c, trailers);
+                ngx_http_v2_queue_frame(fn, trailers);
                 stream->queued++;
             }
 
@@ -1631,6 +1635,7 @@ ngx_http_v2_data_frame_handler(ngx_http_v2_connection_t *h2c,
     stream->request->header_size += NGX_HTTP_V2_FRAME_HEADER_SIZE;
 
     h2c->payload_bytes += frame->length;
+    h2c->send_queued -= frame->length;
 
     ngx_http_v2_handle_frame(stream, frame);
 
@@ -1730,7 +1735,9 @@ ngx_http_v2_filter_cleanup(void *data)
         if (frame->stream == stream && !frame->blocked) {
             *fn = frame->next;
 
-            window += frame->length;
+            if (frame->handler == ngx_http_v2_data_frame_handler) {
+                window += frame->length;
+            }
 
             if (--stream->queued == 0) {
                 break;
@@ -1765,6 +1772,7 @@ ngx_http_v2_filter_cleanup(void *data)
     }
 
     h2c->send_window += window;
+    h2c->send_queued -= window;
 }
 
 
