diff --git a/src/http/v2/ngx_http_v2.c b/src/http/v2/ngx_http_v2.c
index 35683ab75f..807dd59c10 100644
--- a/src/http/v2/ngx_http_v2.c
+++ b/src/http/v2/ngx_http_v2.c
@@ -2222,7 +2222,7 @@ ngx_http_v2_state_settings(ngx_http_v2_connection_t *h2c, u_char *pos,
         return ngx_http_v2_connection_error(h2c, NGX_HTTP_V2_PROTOCOL_ERROR);
     }
 
-    if (h2c->state.flags == NGX_HTTP_V2_ACK_FLAG) {
+    if (h2c->state.flags & NGX_HTTP_V2_ACK_FLAG) {
 
         if (h2c->state.length != 0) {
             ngx_log_error(NGX_LOG_INFO, h2c->connection->log, 0,
@@ -2561,13 +2561,13 @@ ngx_http_v2_state_window_update(ngx_http_v2_connection_t *h2c, u_char *pos,
         return ngx_http_v2_state_complete(h2c, pos, end);
     }
 
-    if (window > NGX_HTTP_V2_MAX_WINDOW - h2c->send_window) {
+    if (window > NGX_HTTP_V2_MAX_WINDOW - h2c->send_window - h2c->send_queued) {
         ngx_log_error(NGX_LOG_INFO, h2c->connection->log, 0,
                       "client violated connection flow control: "
                       "received WINDOW_UPDATE frame "
                       "with window increment %uz "
                       "not allowed for window %uz",
-                      window, h2c->send_window);
+                      window, h2c->send_window + h2c->send_queued);
 
         return ngx_http_v2_connection_error(h2c, NGX_HTTP_V2_FLOW_CTRL_ERROR);
     }
@@ -3192,6 +3192,8 @@ ngx_http_v2_create_stream(ngx_http_v2_connection_t *h2c)
 
     h2c->processing++;
 
+    ngx_reusable_connection(h2c->connection, 0);
+
     if (h2c->connection->read->timer_set) {
         ngx_del_timer(h2c->connection->read);
     }
diff --git a/src/http/v2/ngx_http_v2.h b/src/http/v2/ngx_http_v2.h
index 797e3e8b19..b2eaa5787f 100644
--- a/src/http/v2/ngx_http_v2.h
+++ b/src/http/v2/ngx_http_v2.h
@@ -135,6 +135,7 @@ struct ngx_http_v2_connection_s {
     ngx_uint_t                       refused_streams;
 
     size_t                           send_window;
+    size_t                           send_queued;
     size_t                           recv_window;
     size_t                           init_window;
 
@@ -261,9 +262,11 @@ ngx_http_v2_stream_precedes(ngx_http_v2_stream_t *s,
 }
 
 
-static ngx_inline void
-ngx_http_v2_queue_frame(ngx_http_v2_connection_t *h2c,
-    ngx_http_v2_out_frame_t *frame)
+/* all frames of a stream are queued at the same position */
+
+static ngx_inline ngx_http_v2_out_frame_t **
+ngx_http_v2_queue_position(ngx_http_v2_connection_t *h2c,
+    ngx_http_v2_stream_t *stream)
 {
     ngx_http_v2_out_frame_t  **out;
 
@@ -273,11 +276,19 @@ ngx_http_v2_queue_frame(ngx_http_v2_connection_t *h2c,
             break;
         }
 
-        if (ngx_http_v2_stream_precedes((*out)->stream, frame->stream)) {
+        if (ngx_http_v2_stream_precedes((*out)->stream, stream)) {
             break;
         }
     }
 
+    return out;
+}
+
+
+static ngx_inline void
+ngx_http_v2_queue_frame(ngx_http_v2_out_frame_t **out,
+    ngx_http_v2_out_frame_t *frame)
+{
     frame->next = *out;
     *out = frame;
 }
diff --git a/src/http/v2/ngx_http_v2_filter_module.c b/src/http/v2/ngx_http_v2_filter_module.c
